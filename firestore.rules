rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Faqat admin: Firebase Auth'dagi admin hisobi (UID). Yangi admin qo'shish uchun
    // Authentication > Users'da hisob yarating va uning UID'ini shu ro'yxatga qo'shing.
    // Saytda mijozlarning o'zi ro'yxatdan o'tishi o'chirilgan (2026-11-16).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['V3PXTj7if2fq3qlvWwPFF0MCJny2'];
    }

    function str(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // Sayt formasidan keladigan yangi hujjat: kichik, belgilangan holatda, server vaqti bilan.
    function validNew(status) {
      return request.resource.data.keys().size() <= 20
        && request.resource.data.status == status
        && request.resource.data.notified == false
        && request.resource.data.createdAt == request.time
        && str('name', 100) && str('phone', 40) && str('message', 3000)
        && str('text', 3000) && str('service', 200) && str('source', 100) && str('page', 300);
    }

    // Arizalar (mijozlarning ismi va telefoni) — sayt faqat yoza oladi, o'qish faqat admin.
    match /submissions/{docId} {
      allow create: if validNew('yangi');
      allow read, update, delete: if isAdmin();
    }

    // Sharhlar — hamma yoza oladi (moderatsiyaga tushadi), hammaga faqat tasdiqlanganlari ko'rinadi.
    match /reviews/{docId} {
      allow create: if validNew('kutilmoqda');
      allow read: if isAdmin() || resource.data.status == 'tasdiqlangan';
      allow update, delete: if isAdmin();
    }

    // Narxlar, mutaxassislar, aksiyalar, sozlamalar, blog — sayt o'qiydi, faqat admin yozadi.
    match /prices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /specialists/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boshqa hamma narsa yopiq.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
