rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ariza (lead) formalari — sayt tashrifchilari yoza oladi (create),
    // lekin faqat tizimga kirgan admin o'qiy/yangilay/o'chira oladi.
    match /submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Mijoz sharhlari — hamma yoza (create) va o'qiy (read) oladi, chunki
    // tasdiqlangan sharhlar sayt sahifasida hammaga ko'rsatiladi. Faqat
    // admin moderatsiya qila oladi (holatni o'zgartirish/o'chirish).
    match /reviews/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // Narxlar — hamma o'qiy oladi (sayt shu yerdan narxni ko'rsatadi),
    // faqat admin yoza oladi.
    match /prices/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mutaxassislar, aksiyalar va sayt sozlamalari (telefon, manzil,
    // ish vaqti) — faqat admin tahrirlaydi, sayt esa hammaga ko'rsatadi.
    match /specialists/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog sahifasidagi kartochkalar ro'yxati (to'liq maqola matni emas,
    // faqat sarlavha/qisqacha tavsif/havola) — admin boshqaradi.
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
